# Create this database and a least-privilege account before starting the API.
DATABASE_URL=mysql+pymysql://daily_ai_app:replace_me@127.0.0.1:3306/daily_ai_news?charset=utf8mb4
APP_ENV=development
RSS_SOURCES_FILE=config/rss_sources.json

# Optional OpenAI-compatible endpoint. Use the provider's actual model ID.
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=replace_me
LLM_MODEL=replace_with_model_id
LLM_API_PROTOCOL=chat_completions
LLM_MAX_OUTPUT_TOKENS=2048
AGENT_MODEL_TIMEOUT_SECONDS=45
AGENT_MAX_TOOL_ROUNDS=8
AGENT_MAX_CALLS_PER_ROUND=8
AGENT_MAX_MODEL_INPUT_BYTES=128000
AGENT_MAX_TOTAL_INPUT_BYTES=512000
AGENT_TASK_TIMEOUT_SECONDS=300
SCHEDULER_ENABLED=true

# Generic SMTP settings. Keep blank until an existing mailbox provider is selected.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_TIMEOUT_SECONDS=15
# SMTP_MAX_ATTEMPTS=3
# SMTP_RETRY_BASE_SECONDS=60
